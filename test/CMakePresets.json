{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "IOV2_TEST_MODE": "release",
        "IOV2_TEST_CONSUMER": "source"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "environment": { "CXX": "g++" }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "base",
      "environment": { "CXX": "clang++" }
    },

    {
      "name": "gcc-release",
      "inherits": "gcc",
      "displayName": "g++, release (-O3 -g -DNDEBUG)"
    },
    {
      "name": "clang-release",
      "inherits": "clang",
      "displayName": "clang++, release (-O3 -g -DNDEBUG)"
    },

    {
      "name": "gcc-debug",
      "inherits": "gcc",
      "displayName": "g++, debug (-g -O0)",
      "cacheVariables": { "IOV2_TEST_MODE": "debug" }
    },
    {
      "name": "clang-debug",
      "inherits": "clang",
      "displayName": "clang++, debug (-g -O0)",
      "cacheVariables": { "IOV2_TEST_MODE": "debug" }
    },

    {
      "name": "gcc-sanitizer",
      "inherits": "gcc",
      "displayName": "g++, ASan+UBSan (-O1 -g, no NDEBUG)",
      "cacheVariables": { "IOV2_TEST_MODE": "sanitizer" }
    },
    {
      "name": "clang-sanitizer",
      "inherits": "clang",
      "displayName": "clang++, ASan+UBSan (-O1 -g, no NDEBUG)",
      "cacheVariables": { "IOV2_TEST_MODE": "sanitizer" }
    },

    {
      "name": "gcc-tsan",
      "inherits": "gcc",
      "displayName": "g++, ThreadSanitizer (concur only)",
      "cacheVariables": { "IOV2_TEST_MODE": "tsan" }
    },
    {
      "name": "gcc-coverage",
      "inherits": "gcc",
      "displayName": "g++, coverage (-O0 -g --coverage)",
      "cacheVariables": { "IOV2_TEST_MODE": "coverage" }
    },

    {
      "name": "gcc-installed-shared",
      "inherits": "gcc",
      "displayName": "g++, release, against an installed libiov2.so",
      "cacheVariables": { "IOV2_TEST_CONSUMER": "installed-shared" }
    },
    {
      "name": "gcc-installed-header-only",
      "inherits": "gcc",
      "displayName": "g++, release, against installed headers only",
      "cacheVariables": { "IOV2_TEST_CONSUMER": "installed-header-only" }
    },

    {
      "name": "win-clangcl-xwin",
      "hidden": true,
      "inherits": "base",
      "description": "Cross-built on Linux for Windows (MSVC ABI) and run under Wine; see cmake/toolchains/windows-clangcl-xwin.cmake. IOV2_TEST_COMPONENTS lists the components ported so far.",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-clangcl-xwin.cmake",
      "cacheVariables": { "IOV2_TEST_COMPONENTS": "device" }
    },
    {
      "name": "win-clangcl-xwin-release",
      "inherits": "win-clangcl-xwin",
      "displayName": "clang-cl -> Windows under Wine, release (/O2 /Z7 -DNDEBUG)"
    },
    {
      "name": "win-clangcl-xwin-debug",
      "inherits": "win-clangcl-xwin",
      "displayName": "clang-cl -> Windows under Wine, debug (/Od /Z7)",
      "cacheVariables": { "IOV2_TEST_MODE": "debug" }
    },

    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "description": "Native Windows, from a shell where the MSVC environment is set up (vcvars, or ilammy/msvc-dev-cmd in CI). IOV2_TEST_COMPONENTS lists the components ported so far.",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "IOV2_TEST_COMPONENTS": "device" }
    },
    {
      "name": "windows-msvc-release",
      "inherits": "windows",
      "displayName": "MSVC cl, release (/O2 /Z7 -DNDEBUG)",
      "environment": { "CC": "cl", "CXX": "cl" }
    },
    {
      "name": "windows-clangcl-release",
      "inherits": "windows",
      "displayName": "clang-cl, release (/O2 /Z7 -DNDEBUG)",
      "environment": { "CC": "clang-cl", "CXX": "clang-cl" }
    },
    {
      "name": "macos-clang-release",
      "inherits": "base",
      "displayName": "Apple clang, release (-O3 -g -DNDEBUG)",
      "description": "IOV2_TEST_COMPONENTS lists the components ported so far.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "environment": { "CXX": "clang++" },
      "cacheVariables": { "IOV2_TEST_COMPONENTS": "device" }
    }
  ],

  "buildPresets": [
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "gcc-sanitizer", "configurePreset": "gcc-sanitizer" },
    { "name": "clang-sanitizer", "configurePreset": "clang-sanitizer" },
    { "name": "gcc-coverage", "configurePreset": "gcc-coverage" },
    { "name": "gcc-installed-shared", "configurePreset": "gcc-installed-shared" },
    { "name": "gcc-installed-header-only", "configurePreset": "gcc-installed-header-only" },
    { "name": "win-clangcl-xwin-release", "configurePreset": "win-clangcl-xwin-release" },
    { "name": "win-clangcl-xwin-debug", "configurePreset": "win-clangcl-xwin-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-clangcl-release", "configurePreset": "windows-clangcl-release" },
    { "name": "macos-clang-release", "configurePreset": "macos-clang-release" },
    {
      "name": "gcc-tsan",
      "configurePreset": "gcc-tsan",
      "description": "Only the concur module runs threads; TSan has nothing to observe elsewhere, and building the rest would cost minutes to inspect executions that cannot race.",
      "targets": [ "test_concur" ]
    }
  ],

  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "all" } }
    },
    { "name": "gcc-release", "inherits": "base", "configurePreset": "gcc-release" },
    { "name": "clang-release", "inherits": "base", "configurePreset": "clang-release" },
    { "name": "gcc-debug", "inherits": "base", "configurePreset": "gcc-debug" },
    { "name": "clang-debug", "inherits": "base", "configurePreset": "clang-debug" },
    { "name": "gcc-sanitizer", "inherits": "base", "configurePreset": "gcc-sanitizer" },
    { "name": "clang-sanitizer", "inherits": "base", "configurePreset": "clang-sanitizer" },
    { "name": "gcc-coverage", "inherits": "base", "configurePreset": "gcc-coverage" },
    { "name": "gcc-installed-shared", "inherits": "base", "configurePreset": "gcc-installed-shared" },
    { "name": "gcc-installed-header-only", "inherits": "base", "configurePreset": "gcc-installed-header-only" },
    { "name": "win-clangcl-xwin-release", "inherits": "base", "configurePreset": "win-clangcl-xwin-release" },
    { "name": "win-clangcl-xwin-debug", "inherits": "base", "configurePreset": "win-clangcl-xwin-debug" },
    { "name": "windows-msvc-release", "inherits": "base", "configurePreset": "windows-msvc-release" },
    { "name": "windows-clangcl-release", "inherits": "base", "configurePreset": "windows-clangcl-release" },
    { "name": "macos-clang-release", "inherits": "base", "configurePreset": "macos-clang-release" },
    {
      "name": "gcc-tsan",
      "configurePreset": "gcc-tsan",
      "description": "Repeated because a race is only reported when the schedule actually exercises it; one clean run is weaker evidence than several.",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "concur" } },
      "execution": { "repeat": { "mode": "until-fail", "count": 10 } }
    }
  ]
}
