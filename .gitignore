# Leftovers from test/Makefile, which is gone. Nothing writes these any more,
# but a checkout that ever ran it still has them, and they are large enough that
# unignoring them is how one gets committed by accident. Delete yours; this rule
# can go once nobody has them.
test/bin_*/
test/obj_*/

# CMake build trees, one per compiler/mode/consumer combination and named after
# the preset that created it. Out-of-source by design: moving off test/Makefile
# is what stopped obj_*/bin_* being generated inside the source tree.
/build/

# Coverage data
*.gcda
*.gcno
coverage.info

# Auto-generated documentation (should not be committed to source tree)
docs/en/
docs/zh/
docs/.nojekyll

# Locally-generated compilation database for clangd/IDE (machine-specific
# absolute paths; regenerate locally, do not commit)
compile_commands.json
.cache/
