CompileFlags:
  # The compile commands CMake writes for the tests, so clangd sees the same
  # flags as the build: include/, test/, GoogleTest and Botan included. Headers
  # borrow the flags of a source that includes them. Generated by configuring
  # once: cd test && cmake --preset gcc-release
  #
  # Not hand-written -I flags: without a compilation database clangd resolves
  # those against the open file's directory, so -Iinclude found nothing.
  CompilationDatabase: build/gcc-release
  # Remove -Werror so IDE warnings don't show as errors
  Remove:
    - -Werror
